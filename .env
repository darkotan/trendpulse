# TrendPulse Environment Variables
# Fill in your Stripe keys after creating a Stripe account

# Stripe API Keys (get from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_SECRET_HERE

# Stripe Price IDs (get from https://dashboard.stripe.com/products after creating products)
STRIPE_MONTHLY_PRICE_ID=price_YOUR_MONTHLY_ID
STRIPE_YEARLY_PRICE_ID=price_YOUR_YEARLY_ID
